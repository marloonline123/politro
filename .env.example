# ==============================================================================
# Instagram Food Lead Qualification Bot Configuration
# ==============================================================================

# AI Provider Configuration (Default: OpenRouter with free models)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=s***
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional custom base URL:
# AI_BASE_URL=https://openrouter.ai/api/v1

# 2Captcha Browser API (Cloud Browser via CDP WebSocket)
# Connects Playwright to 2Captcha managed browser with automatic CAPTCHA handling
USE_2CAPTCHA=false
TWOCAPTCHA_BROWSER_LOGIN=***
TWOCAPTCHA_BROWSER_PASSWORD=***
TWOCAPTCHA_COUNTRY_CODE=us

# Optional: Custom Proxy for 2Captcha Browser
# TWOCAPTCHA_PROXY_PROTOCOL=http
# TWOCAPTCHA_PROXY_HOST=proxy.example.com
# TWOCAPTCHA_PROXY_PORT=3128
# TWOCAPTCHA_PROXY_LOGIN=proxy_user
# TWOCAPTCHA_PROXY_PASSWORD=proxy_pass

# Or specify ready-made CDP WebSocket URL directly:
# TWOCAPTCHA_BROWSER_WS_URL=ws://login-pid-profile_1-zone-scraping_browser-country-us:password@cb.2captcha.com:9222

# Operational Limits & Pacing
CONCURRENCY=2
REQUEST_DELAY_MS=1500
TIMEOUT_MS=30000
MAX_POSTS_TO_INSPECT=6

# Local Browser Settings (Used when USE_2CAPTCHA=false)
HEADLESS=true

# Output & Web Dashboard Server
OUTPUT_DIR=output
PORT=3000
